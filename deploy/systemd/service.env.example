# Install as /etc/master-control-program/service.env, root-owned mode 0600.
# systemd EnvironmentFile syntax: NAME=value, no "export" or shell expansion.
# The saved token contains the client ID. Confidential apps also require:
X_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET

# Opt in only after account and connection verification.
MCP_X_ENABLE_WRITES=0
MCP_CHATGPT_FILES=0
# For file inputs, set MCP_CHATGPT_FILES=1 and an authorized storage hostname.
# Also supported: MCP_CHATGPT_FILE_HOSTS="oaisdmntpr*.blob.core.windows.net"
# MCP_CHATGPT_FILE_HOSTS=YOUR_VERIFIED_FILE_HOST
